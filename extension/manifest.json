{
    "manifest_version": 3,
    "name": "Neosrc Redirector",
    "version": "0.5.0",
    "description": "Opens supported GitHub pages (pull requests, issues, commits, repositories) in Neosrc.",
    "host_permissions": [
        "https://github.com/*",
        "https://www.github.com/*",
        "https://neosrc.dev/*",
        "https://www.neosrc.dev/*",
        "http://localhost/*"
    ],
    "optional_host_permissions": ["*://*/*"],
    "permissions": ["declarativeNetRequest", "storage", "alarms"],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_popup": "popup/popup.html",
        "default_title": "Neosrc",
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "content_scripts": [
        {
            "matches": ["https://github.com/*", "https://www.github.com/*"],
            "js": ["routes.generated.js", "lib/route-table.js", "content.js"],
            "run_at": "document_start"
        }
    ]
}
