{
    "name": "neosrc",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "next build",
        "check": "biome check .",
        "check:unsafe": "biome check --write --unsafe .",
        "check:write": "biome check --write .",
        "test": "vitest run",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "db:push": "drizzle-kit push",
        "db:studio": "drizzle-kit studio",
        "dev": "next dev",
        "e2e": "dotenv -e .env.e2e -- playwright test",
        "e2e:install": "playwright install --with-deps chromium",
        "e2e:setup": "dotenv -e .env.e2e -- npx drizzle-kit push",
        "e2e:ui": "dotenv -e .env.e2e -- playwright test --ui",
        "functional-test": "dotenv -e .env.test -- playwright test --config=playwright.functional.config.cjs --project=chromium",
        "functional-test:ui": "dotenv -e .env.test -- playwright test --ui --config=playwright.functional.config.cjs --project=chromium",
        "functional-test:setup": "dotenv -e .env.test -- npx drizzle-kit push",
        "generate:icon-map": "pnpx tsx scripts/generate-icon-map.ts",
        "knip": "SKIP_ENV_VALIDATION=1 knip",
        "preview": "next build && next start",
        "start": "next start",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@octokit/graphql": "^9.0.4",
        "@octokit/openapi-types": "^27.0.0",
        "@octokit/plugin-rest-endpoint-methods": "^17.0.0",
        "@octokit/rest": "^22.0.1",
        "@t3-oss/env-nextjs": "^0.13.11",
        "@tanstack/react-query": "^5.101.4",
        "@tanstack/react-virtual": "^3.14.9",
        "@trpc/client": "^11.18.0",
        "@trpc/react-query": "^11.18.0",
        "@trpc/server": "^11.18.0",
        "better-auth": "^1.6.26",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "diff2html": "^3.4.56",
        "drizzle-orm": "^0.45.2",
        "fzf": "^0.5.2",
        "highlight.js": "^11.11.1",
        "jose": "^6.2.8",
        "lucide-react": "^1.29.0",
        "next": "^16.3.0",
        "next-themes": "^0.4.6",
        "node-emoji": "^2.2.0",
        "pino": "^10.3.1",
        "postgres": "^3.4.4",
        "radix-ui": "^1.6.7",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "react-markdown": "^10.1.0",
        "rehype-raw": "^7.0.0",
        "rehype-sanitize": "^6.0.0",
        "remark-breaks": "^4.0.0",
        "remark-gfm": "^4.0.1",
        "remark-github-blockquote-alert": "^2.1.0",
        "server-only": "^0.0.1",
        "superjson": "^2.2.1",
        "tailwind-merge": "^3.6.0",
        "tw-animate-css": "^1.4.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.0",
        "@playwright/test": "^1.62.1",
        "@tailwindcss/postcss": "^4.3.3",
        "@tailwindcss/typography": "^0.5.20",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/jest-dom": "^7.0.0",
