        "@testing-library/user-event": "^14.6.3",
        "@types/node": "^22.20.1",
        "@types/react": "19.2.18",
        "@types/react-dom": "19.2.4",
        "@types/react-syntax-highlighter": "^15.5.13",
        "@vitejs/plugin-react": "^6.0.5",
        "dotenv-cli": "^11.0.0",
        "drizzle-kit": "^0.31.10",
        "jsdom": "^30.0.1",
        "knip": "^6.32.0",
        "msw": "^2.15.0",
        "pino-pretty": "^13.1.3",
        "postcss": "^8.5.26",
        "react-syntax-highlighter": "^16.1.1",
        "remark-parse": "^11.0.0",
